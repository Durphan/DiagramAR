{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node --watch dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/tests/**/*.test.js\"",
    "test:coverage": "tsc && node --test --experimental-test-coverage \"dist/tests/**/*.test.js\"",
    "db:migrate:generate": "typeorm migration:generate migrations/$(date +%Y%m%d%H%M%S) -d dist/src/config/data-source.js",
    "db:migrate": "typeorm migration:run -d dist/src/config/data-source.js",
    "db:migrate:undo": "typeorm migration:revert -d dist/src/config/data-source.js",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "better-sqlite3": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "winston": "^3.x",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
